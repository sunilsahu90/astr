---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

// You can define dynamic data here later (e.g., fetching available lab equipment)
const features = [
  { title: "CIF Sharing", desc: "Book time on high-end analytical instruments." },
  { title: "Virtual Lab Assistant", desc: "Access standard operating procedures and simulations." },
  { title: "Resource Aggregation", desc: "Centralized repository for literature and datasets." }
];
---

<Layout title="Shodhkarta | Central Instrumentation Facility">
	<main>
		<Hero />
		
        <section class="py-24 bg-slate-800/50 relative z-10">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid md:grid-cols-3 gap-8">
                    {features.map((feature, index) => (
                        <div class="glass-card p-8 rounded-2xl hover:bg-white/5 transition-all duration-300 transform hover:-translate-y-2">
                            <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
                            <p class="text-slate-400 text-sm leading-relaxed">{feature.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>
	</main>
</Layout>
